{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TicketTriageResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "category",
    "subcategory",
    "priority",
    "target_team",
    "risk_tags",
    "needs_human_review",
    "reason_codes"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
    "category": {
      "type": "string",
      "enum": ["account", "billing", "integration", "performance", "product", "security", "unknown"]
    },
    "subcategory": { "type": "string", "minLength": 1, "maxLength": 64 },
    "priority": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
    "target_team": {
      "type": "string",
      "enum": ["identity_platform", "billing_ops", "developer_platform", "site_reliability", "product_ops", "security_response", "customer_success"]
    },
    "risk_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 64 }
    },
    "needs_human_review": { "type": "boolean" },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
    }
  }
}
